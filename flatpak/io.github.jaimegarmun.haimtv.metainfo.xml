<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.jaimegarmun.haimtv</id>

  <name>Haim TV</name>
  <summary>Watch IPTV from M3U playlists and Xtream sources</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <developer id="io.github.jaimegarmun">
    <name>jaimegarmun</name>
  </developer>

  <description>
    <p>
      Haim TV is a simple and fast IPTV player.
    </p>
    <p>Features:</p>
    <ul>
      <li>M3U and Xtream Codes support</li>
      <li>Live TV, movies and series</li>
      <li>Favorites and fast search</li>
      <li>Powered by mpv for smooth playback</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.jaimegarmun.haimtv.desktop</launchable>

  <url type="homepage">https://github.com/jaimegarmun/Haim-TV-IPTV</url>
  <url type="bugtracker">https://github.com/jaimegarmun/Haim-TV-IPTV/issues</url>

  <screenshots>
    <screenshot type="default">
      <caption>Browsing channels in Haim TV</caption>
      <image>https://github.com/user-attachments/assets/baf0c53b-a33a-4bb7-bf48-24b8dd20fb20</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="1.0.2" date="2026-09-19">
      <description>
        <p>Spanish language, TV search screen with a QWERTY keyboard, app icon in every size for taskbars.</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-09-19">
      <description>
        <p>Update check on start, Channels / Movies / Series filter, fixes for TV remotes.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-09-19">
      <description>
        <p>First release of Haim TV.</p>
      </description>
    </release>
  </releases>
</component>
